//------------------------------------------------
//--- 010 Editor v10.0.2 Binary Template
//
//      File: nuccChunkModel.bt
//   Authors: SutandoTsukai181, TheLeonX, Hydra
//   Version: 1.4
//   Purpose: Parse nuccChunkModel and its embedded Bandai Namco/CC2 NUD data
//  Category:
// File Mask:
//  ID Bytes:
//   History:
//   1.0 - Initial release
//   1.1 - Updated names/flags/layout from Blender-XFBIN-Importer br_nud.py
//   1.2 - Documented executable-confirmed offset bases and shader identifiers
//   1.3 - Pass the embedded NUD base explicitly when seeking mesh headers
//   1.4 - Moved the TNuccModel chunk wrapper here from nucc.bt
//------------------------------------------------

// NSUNS4_107: 0x140A89800 builds NUD lookup tables, 0x140A8A540
// converts headers and buffers, 0x140A388B0 uses material +0 as a shader ID.
// Buffer offsets and table sizes below are confirmed by those routines.
// Vertex semantic labels and render-state enums remain inherited importer
// interpretations unless a field comment explicitly describes runtime usage.

#ifndef NUD
#define NUD
#endif

#include "/../include.h";
BigEndian();

string ReadNudVertexType(u8& value)
{
    local string str;
    local u8 vertexType = value & 0x0F;
    switch (vertexType)
    {
        case 0x00: return "FloatPosition";
        case 0x01: return "FloatPosition Normal";
        case 0x02: return "FloatPosition TangentBitangent";
        case 0x03: return "FloatPosition Normal TangentBitangent";
        case 0x04: return "HalfNormalPosition";
        case 0x05: return "HalfNormalPosition TangentBitangent";
        case 0x06: return "HalfNormalPosition Normal";
        case 0x07: return "HalfNormalPosition Normal TangentBitangent";
    }
    SPrintf(str, "VertexType 0x%X", vertexType);
    return str;
}

string ReadNudBoneType(u8& value)
{
    local string str;
    local u8 boneType = value & 0xF0;
    switch (boneType)
    {
        case 0x00: return "NoBones";
        case 0x10: return "BonesFloat";
        case 0x20: return "BonesHalfFloat";
        case 0x40: return "BonesByte";
    }
    SPrintf(str, "BoneType 0x%X", boneType);
    return str;
}

string ReadNudUvColorFlags(u8& value)
{
    local string str;
    local u8 uvCount = value >> 4;
    local u8 uvType = value & 0x0F;
    local string typeName;
    switch (uvType)
    {
        case 0x00:
            typeName = "NoColorHalfUV";
            break;
        case 0x01:
            typeName = "NoColorFloatUV";
            break;
        case 0x02:
            typeName = "ByteColorHalfUV";
            break;
        case 0x03:
            typeName = "ByteColorFloatUV";
            break;
        case 0x04:
            typeName = "HalfColorHalfUV";
            break;
        case 0x05:
            typeName = "HalfColorFloatUV";
            break;
        default:
            typeName = "Unknown";
            break;
    }
    SPrintf(str, "%s UVs[%d]", typeName, uvCount);
    return str;
}

u32 GetNudUvColorSize(u8 uvColorFlags)
{
    local u32 size = 0;
    local u8 uvCount = uvColorFlags >> 4;
    local u8 uvType = uvColorFlags & 0x0F;

    if (uvType & 0x02)
    {
        size += 4;
    }
    else if (uvType & 0x04)
    {
        size += 8;
    }

    if (uvType & 0x01)
    {
        size += uvCount * 8;
    }
    else
    {
        size += uvCount * 4;
    }

    return size;
}

u32 GetNudVertexMainSize(u8 vertexFlags)
{
    local u32 size = 12;
    local u8 vertexType = vertexFlags & 0x0F;
    local u8 boneType = vertexFlags & 0xF0;

    if (!(vertexType & 0x04))
    {
        size += 4;
        if (vertexType & 0x01)
        {
            size += 16;
        }
        if (vertexType & 0x02)
        {
            size += 32;
        }
    }
    else
    {
        if (vertexType & 0x02)
        {
            size += 8;
        }
        if (vertexType & 0x01)
        {
            size += 16;
        }
    }

    if (boneType == 0x10)
    {
        size += 32;
    }
    else if (boneType == 0x20)
    {
        size += 16;
    }
    else if (boneType == 0x40)
    {
        size += 8;
    }

    return size;
}

typedef struct
{
    u8 BaseID <format=hex>;
    u8 GroupID <format=hex>;
    u8 SubGroupID <format=hex>;
    u8 TextureID <format=hex>;

    u32 Field04;
    u16 Field08;
    u16 MapMode;
    u8 WrapModeS;
    u8 WrapModeT;
    u8 MinFilter;
    u8 MagFilter;
    u8 MipDetail;
    u8 Field11;
    u32 Field12;
    u16 LOD;
} TNudMaterialTexture <optimize=false>;

typedef struct(u64 materialEnd)
{
    local u64 entryStart = FTell();

    u32 MatAttSize <comment="Byte step to the next property record; zero terminates the chain.">;
    u32 NameStart <comment="Offset into the NUD name/string buffer, not an XFBIN chunk index.">;
    u8 Field08[3];
    u8 ValueCount;
    u32 Field0C;

    if (ValueCount)
    {
        f32 Values[ValueCount];
    }

    local u64 propertyEnd = entryStart + MatAttSize;
    if (materialEnd != 0 && propertyEnd > materialEnd)
    {
        propertyEnd = materialEnd;
    }
    local u32 PaddingSize = 0;
    if (MatAttSize > 0 && FTell() < propertyEnd)
    {
        PaddingSize = propertyEnd - FTell();
        if (PaddingSize <= MatAttSize)
        {
            FSkip(PaddingSize);
        }
        else
        {
            FSeek(propertyEnd);
        }
    }
} TNudMaterialProperty <optimize=false>;

string ReadNudMaterialProperty(TNudMaterialProperty& value)
{
    local string str;
    if (value.MatAttSize == 0)
    {
        return "End";
    }
    SPrintf(str, "NameStart[0x%X] Values[%d]", value.NameStart, value.ValueCount);
    return str;
}

typedef struct(u64 materialEnd)
{
    local u64 materialStart = startof(this);
    local int textureIndex;

    u32 ShaderID <format=hex, comment="Passed to the shader parameter/manager lookup by nuccChunkModel::Parse; previously named Flags.">;
    u32 Field04;

    u16 SourceFactor;
    u16 TextureCount;
    u16 DestinationFactor;

    u8 AlphaTest;
    u8 AlphaFunction;
    u16 RefAlpha;
    u16 CullMode;

    f32 Field14; // Always 0 in most files.
    f32 Field18; // Usually 0, sometimes 1.
    s32 ZBufferOffset;

    while (textureIndex < TextureCount && FTell() + 24 <= materialEnd)
    {
        struct TNudMaterialTexture Texture <optimize=false>;
        textureIndex++;
    }
    local u32 materialRelativeOffset = FTell() - materialStart;
    FSeek(materialStart + Align(materialRelativeOffset, 8));

    local int propIndex = 0;
    local int finished = 0;
    while (!finished && FTell() + 16 <= materialEnd)
    {
        struct TNudMaterialProperty Property(materialEnd) <read=ReadNudMaterialProperty>;
        if (Property.MatAttSize == 0)
        {
            finished = 1;
        }
        propIndex++;
    }
} TNudMaterial <optimize=false>;

typedef struct
{
    u32 PolyClumpStart <comment="Relative to the NUD index-buffer base, not the file start.">;
    u32 VertClumpStart <comment="Relative to the primary vertex-buffer base.">;
    u32 VertAddClumpStart <comment="Relative to the additional/skinned vertex-buffer base.">;

    u16 VertexCount;
    u8 VertexFlags <read=ReadNudVertexType>;
    u8 UvColorFlags <read=ReadNudUvColorFlags>;

    u32 MaterialOffsets[4] <comment="Offsets from NDP3 start; engine stops at the first zero slot.">;

    u16 FaceCount <comment="Number of 16-bit index entries, not the number of triangles.">;
    u8 FaceSize;
    u8 FaceFlag;
    u32 Padding[3] <hidden=true>;
} TNudMeshHeader <optimize=false, read=ReadNudMeshHeader>;

string ReadNudMeshHeader(TNudMeshHeader& value)
{
    local string str;
    SPrintf(str, "Verts[%d] Faces[%d] %s %s",
        value.VertexCount,
        value.FaceCount,
        ReadNudVertexType(value.VertexFlags),
        ReadNudBoneType(value.VertexFlags));
    return str;
}

typedef struct(u64 nudStart)
{
    struct TVector4 BoundingSphere;
    f32 UnknownValues[4];
    u32 NameStart;
    u16 Field24;
    u16 BoneFlags;
    s16 SingleBind;
    u16 MeshCount;
    u32 MeshHeaderStart <comment="Offset from NDP3 start to MeshCount headers, each 0x30 bytes.">;

    FPush();
    // MeshHeaderStart is NDP3-relative. An enclosing model wrapper can be
    // 0x1C or 0x34 bytes long, so walking its parents is not a valid base.
    FSeek(nudStart + MeshHeaderStart);
    struct TNudMeshHeader Meshes[MeshCount] <optimize=false>;
    FPop();
} TNudMeshGroup <optimize=false>;

typedef struct(u8 uvColorFlags)
{
    local u8 uvCount = uvColorFlags >> 4;
    local u8 uvType = uvColorFlags & 0x0F;
    local int u;

    if (uvType & 0x02)
    {
        u8 Color[4];
    }
    else if (uvType & 0x04)
    {
        f16 Color[4];
    }

    for (u = 0; u < uvCount; u++)
    {
        if (uvType & 0x01)
        {
            struct TVector2 UVFloat;
        }
        else
        {
            struct TVector2Half UVHalf;
        }
    }
} TNudUvColor <optimize=false>;

typedef struct(u8 vertexFlags)
{
    local u8 vertexType = vertexFlags & 0x0F;
    local u8 boneType = vertexFlags & 0xF0;

    struct TVector3 Position;

    if (!(vertexType & 0x04))
    {
        f32 PositionW;

        if (vertexType & 0x01)
        {
            struct TVector3 Normal;
            f32 NormalW;
        }

        if (vertexType & 0x02)
        {
            struct TVector4 Bitangent;
            struct TVector4 Tangent;
        }
    }
    else
    {
        if (vertexType & 0x02)
        {
            f16 Normal[3];
            f16 NormalW;
        }

        if (vertexType & 0x01)
        {
            f16 Bitangent[4];
            f16 Tangent[4];
        }
    }

    if (boneType == 0x10)
    {
        u32 BoneID[4];
        f32 BoneWeight[4];
    }
    else if (boneType == 0x20)
    {
        u16 BoneID[4];
        f16 BoneWeight[4];
    }
    else if (boneType == 0x40)
    {
        u8 BoneID[4];
        u8 BoneWeight[4];
    }
} TNudVertexMain <optimize=false>;

typedef struct(u16 faceCount, u64 faceEnd)
{
    local int faceIndex;
    for (faceIndex = 0; faceIndex < faceCount && FTell() + 2 <= faceEnd; faceIndex++)
    {
        u16 Index;
    }
} TNudFaceBuffer <optimize=false>;

typedef struct
{
    local u64 nudStart = startof(this);
    local int g;
    local int m;
    local int v;
    local int materialSlot;
    local int materialEndSlot;
    local u32 materialOffset;
    local u32 materialEndOffset;
    local u32 uvColorSize;
    local u32 vertexMainSize;
    local u64 faceBufferEnd;
    local u64 vertexBufferEnd;

    char Magic[4]; Assert(Magic == "NDP3");
    u32 FileSize;
    u16 Version;
    u16 MeshGroupCount;

    // Bone indices in the clump coord array.
    u16 BoneStart;
    u16 BoneEnd;

    u32 PolyClumpStartRaw <comment="Index buffer begins at NDP3 start + 0x30 + this value.">;
    u32 PolyClumpSize;
    local u32 PolyClumpStart = PolyClumpStartRaw + 0x30;

    u32 VertClumpSize;
    local u32 VertClumpStart = PolyClumpStart + PolyClumpSize;

    u32 VertAddClumpSize;
    local u32 VertAddClumpStart = VertClumpStart + VertClumpSize;

    local u32 NameStart = VertAddClumpStart + VertAddClumpSize;
    // Name offsets refer to this final buffer; not the chunk-table name strings.

    struct TVector4 BoundingSphere;

    struct TNudMeshGroup MeshGroups(nudStart)[MeshGroupCount] <optimize=false>;

    FPush();
    {
        struct
        {
            for (g = 0; g < MeshGroupCount; g++)
            {
                struct
                {
                    for (m = 0; m < MeshGroups[g].MeshCount; m++)
                    {
                        struct
                        {
                            for (materialSlot = 0; materialSlot < 4; materialSlot++)
                            {
                                materialOffset = MeshGroups[g].Meshes[m].MaterialOffsets[materialSlot];
                                if (materialOffset != 0 && PolyClumpStart >= 28 && materialOffset <= PolyClumpStart - 28)
                                {
                                    materialEndOffset = PolyClumpStart;
                                    for (materialEndSlot = 0; materialEndSlot < 4; materialEndSlot++)
                                    {
                                        if (MeshGroups[g].Meshes[m].MaterialOffsets[materialEndSlot] > materialOffset &&
                                            MeshGroups[g].Meshes[m].MaterialOffsets[materialEndSlot] < materialEndOffset)
                                        {
                                            materialEndOffset = MeshGroups[g].Meshes[m].MaterialOffsets[materialEndSlot];
                                        }
                                    }

                                    FSeek(nudStart + materialOffset);
                                    struct TNudMaterial Material(nudStart + materialEndOffset) <optimize=false>;
                                }
                            }
                        } Materials;
                    }
                } MeshGroup;
            }
        } MaterialBuffers;
    }
    FPop();

    FPush();
    {
        struct
        {
            for (g = 0; g < MeshGroupCount; g++)
            {
                struct
                {
                    for (m = 0; m < MeshGroups[g].MeshCount; m++)
                    {
                        if (MeshGroups[g].Meshes[m].PolyClumpStart < PolyClumpSize)
                        {
                            FSeek(nudStart + PolyClumpStart + MeshGroups[g].Meshes[m].PolyClumpStart);
                            faceBufferEnd = nudStart + PolyClumpStart + PolyClumpSize;
                            struct TNudFaceBuffer Faces(MeshGroups[g].Meshes[m].FaceCount, faceBufferEnd);
                        }
                    }
                } MeshGroup;
            }
        } FaceBuffers;
    }
    FPop();

    FPush();
    {
        struct
        {
            for (g = 0; g < MeshGroupCount; g++)
            {
                struct
                {
                    for (m = 0; m < MeshGroups[g].MeshCount; m++)
                    {
                        if ((MeshGroups[g].Meshes[m].VertexFlags & 0xF0) != 0)
                        {
                            uvColorSize = GetNudUvColorSize(MeshGroups[g].Meshes[m].UvColorFlags);
                            vertexMainSize = GetNudVertexMainSize(MeshGroups[g].Meshes[m].VertexFlags);

                            FSeek(nudStart + VertClumpStart + MeshGroups[g].Meshes[m].VertClumpStart);
                            vertexBufferEnd = nudStart + VertClumpStart + VertClumpSize;
                            struct
                            {
                                for (v = 0; v < MeshGroups[g].Meshes[m].VertexCount && FTell() + uvColorSize <= vertexBufferEnd; v++)
                                {
                                    struct TNudUvColor UvColor(MeshGroups[g].Meshes[m].UvColorFlags);
                                }
                            } UvColorBuffer;

                            FSeek(nudStart + VertAddClumpStart + MeshGroups[g].Meshes[m].VertAddClumpStart);
                            vertexBufferEnd = nudStart + VertAddClumpStart + VertAddClumpSize;
                            struct
                            {
                                for (v = 0; v < MeshGroups[g].Meshes[m].VertexCount && FTell() + vertexMainSize <= vertexBufferEnd; v++)
                                {
                                    struct TNudVertexMain Vertex(MeshGroups[g].Meshes[m].VertexFlags);
                                }
                            } VertexBuffer;
                        }
                        else
                        {
                            uvColorSize = GetNudUvColorSize(MeshGroups[g].Meshes[m].UvColorFlags);
                            vertexMainSize = GetNudVertexMainSize(MeshGroups[g].Meshes[m].VertexFlags);

                            FSeek(nudStart + VertClumpStart + MeshGroups[g].Meshes[m].VertClumpStart);
                            vertexBufferEnd = nudStart + VertClumpStart + VertClumpSize;
                            struct
                            {
                                for (v = 0; v < MeshGroups[g].Meshes[m].VertexCount && FTell() + vertexMainSize + uvColorSize <= vertexBufferEnd; v++)
                                {
                                    struct TNudVertexMain Vertex(MeshGroups[g].Meshes[m].VertexFlags);
                                    struct TNudUvColor UvColor(MeshGroups[g].Meshes[m].UvColorFlags);
                                }
                            } VertexBuffer;
                        }
                    }
                } MeshGroup;
            }
        } VertexBuffers;
    }
    FPop();

    FSeek(nudStart + FileSize);
} TNud <optimize=false>;

#ifdef XFBIN
typedef struct
{
    // NX 0x71010E0F20 / PC 0x140A388B0. Serialized references are not runtime pointers.
    u16 MaterialGroupCount <comment="Former Field00. Number of material-index groups after the NUD payload.">;
    u16 RiggingFlag;

    u16 Attributes <format=hex, comment="Mask 0x04 adds six float32 bounding-box components before the NUD.">;
    local u32 PageStartForRead = parentof(parentof(this)).pageStart;

    if ( parentof(this).Version > 0x73 && parentof(this).Version < 0x76 )
    {
        u16 Padding0;
        u32 ClumpIndex <read=ReadTXfbinChunkIndexU32(this, parentof(parentof(parentof(this))).pageStart)>;
        u32 HitIndex <read=ReadTXfbinChunkIndexU32(this, parentof(parentof(parentof(this))).pageStart)>;
        u32 MeshBoneIndex <comment="Stored numeric bone/coordinate selector; NOT resolved through the XFBIN page index table.">;
        u32 NudSize <comment="Embedded NUD byte count; material groups follow these bytes.">;
        u8 RenderLayer <comment="Versions 0x74/0x75 store this at payload +0x18.">;
        u8 Reserved19;
        u8 LightModeID <comment="Versions 0x74/0x75 store this at payload +0x1A.">;
        u8 Reserved1B;
    }
    else
    {
        if ( parentof(this).Version > 0x75 )
        {
            u8 RenderLayer;
            u8 LightModeID;
        }
        else
        {
            u8 LegacyReserved06[2] <comment="The inspected loaders default runtime layer/light-mode bytes to zero for versions through 0x73.">;
        }
        if ( parentof(this).Version > 0x73 )
            u32 LightCategoryFlag;
        u32 ClumpIndex <read=ReadTXfbinChunkIndexU32(this, parentof(parentof(parentof(this))).pageStart)>;
        u32 HitIndex <read=ReadTXfbinChunkIndexU32(this, parentof(parentof(parentof(this))).pageStart)>;
        u32 MeshBoneIndex <comment="Stored numeric bone/coordinate selector; NOT resolved through the XFBIN page index table.">;
        u32 NudSize <comment="Embedded NUD byte count; material groups follow these bytes.">;
    }

    if ( Attributes & 0x04 )
    {
        f32 BoundingBox[6] <comment="Two XYZ vectors passed to nuccBoundingBox; serialized as float32.">;
    }

    #ifdef NUD
        FPushBase();
        {
            struct TNud Nud;
        }
        FPopBase();
    #else
        u8 Data[NudSize];
    #endif

    local u32 materialGroup;
    for ( materialGroup = 0; materialGroup < MaterialGroupCount; materialGroup++ )
    {
        struct
        {
            u16 MaterialCount;
            if ( MaterialCount )
                struct TXfbinChunkIndexU32 MaterialIndices(PageStartForRead)[MaterialCount];
        } MaterialGroup <optimize=false>;
    }
} TNuccModel;
#endif

#ifndef XFBIN
    struct TNud Nud;
#endif
