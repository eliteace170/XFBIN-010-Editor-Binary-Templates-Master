//------------------------------------------------
//--- 010 Editor v10.0.2 Binary Template
//
//      File: nut.bt
//   Authors: SutandoTsukai181 (Based on Smash Forge implementation)
//   Version: 1.1
//   Purpose: Parse Bandai Namco NUT texture files
//  Category: 
// File Mask: 
//  ID Bytes: 
//   History: 
//   1.0 - Initial release
//   1.1 - Runtime offset context and texture-record extent preservation
//------------------------------------------------



#define NUT

#include "/../include.h";

local u32 nutColor = SetRandomBackColor();
local u32 nutTexColor = SetRandomBackColor();

typedef struct
{
    SetBackColor(nutColor);

    char Magic[4]; Assert( Magic == "NTP3" );
    u16 Version;

    u16 Count <comment="Texture-record count; each record advances by its own TotalSize.">;
    u32 Padding[2] <hidden=true>;

    struct TNutTexture NutTexture[Count];
} TNut <optimize=false>;

typedef struct
{
    SetBackColor(nutTexColor);

    local u64 startPosition = FTell();

    u32 TotalSize <comment="Complete texture-record byte size, including headers, data and padding.">;
    u32 Field04 <hidden=true>;

    u32 DataSize <comment="Encoded image data size; decoding/swizzle depends on PixelFormat and platform.">;
    u16 HeaderSize <comment="Texture header byte length; current detailed view follows the inline-data layout.">;
    u16 Field0E <hidden=true>;

    u8 Field10 <hidden=true>;
    u8 MipmapCount <comment="Includes the largest image level; a size table follows when greater than one.">;
    u8 Field12 <hidden=true>;
    u8 PixelFormat;

    u16 Width;
    u16 Height;

    u32 Field18 <hidden=true>;
    u32 Caps2 <hidden=true>;

    local bool isCubemap = false;
    if ( (Caps2 & 0x200) == 0x200 )
    {
        isCubemap = true;
    }

    // This is for versions < 0x0200 only
    u32 Padding[4] <hidden=true>;

    if ( isCubemap )
    {
        u32 CubemapSize1;
        u32 CubemapSize2;
        u32 Field38[2];
    }

    if ( MipmapCount > 1 ) 
    {
        u32 MipmapSizes[MipmapCount];
    
        if ( ( FTell() - startPosition ) % 0x10 )
        {
            FSkip( 0x10 - ( ( FTell() - startPosition ) % 0x10 ) );
        }
    }

    FSkip( 0x10 );

    char GIDX[4];
    FSkip( 4 );

    u32 HashId <format=hex, comment="Runtime texture identifier in GIDX; may be assigned/replaced when the XFBIN loads.">;
    FSkip( 4 );

    local int i;
    local int size;

    if (MipmapCount > 1)
    {
        struct
        {
            for (i = 0; i < MipmapCount; i++)
            {
                struct
                {
                    size = MipmapSizes[i];
                    u8 Data[size];
                } Mipmap;
            }
        } TextureData;
    }
    else
    {
        u8 TextureData[DataSize];
    }
    // GetInfo advances by TotalSize even when data includes additional cube
    // faces or padding. Preserve such bytes instead of misreading the next
    // texture header at the end of only the first mip chain.
    Assert(FTell() <= startPosition + TotalSize, "NUT texture exceeds its TotalSize");
    if (FTell() < startPosition + TotalSize)
    {
        u8 RemainingTextureData[startPosition + TotalSize - FTell()]
            <comment="Remaining encoded data/padding; may include additional cubemap faces.">;
    }
} TNutTexture <optimize=false, read=ReadNutTexture>;

string ReadNutTexture(TNutTexture& value)
{
    local string str;
    SPrintf(str, "%d x %d | format %d | %d mips | ID 0x%X",
        value.Width, value.Height, value.PixelFormat, value.MipmapCount, value.HashId);
    return str;
}

#ifndef XFBIN
    BigEndian();
    TNut Nut;
#endif
