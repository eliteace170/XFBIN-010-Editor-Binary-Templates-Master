// Shared page-local index wrappers used by several chunk templates.
typedef struct(u32 pageStart)
{
    local u32 PageStart = pageStart;
    u32 Index;
} TXfbinChunkIndexU32 <optimize=false, read=ReadTXfbinChunkIndexU32Struct>;

typedef struct(u32 pageStart)
{
    local u32 PageStart = pageStart;
    s32 Index;
} TXfbinChunkIndexS32 <optimize=false, read=ReadTXfbinChunkIndexS32Struct>;

string ReadTXfbinChunkIndexU32Struct(TXfbinChunkIndexU32& value)
{
    return ReadTXfbinChunkIndexU32(value.Index, value.PageStart);
}

string ReadTXfbinChunkIndexS32Struct(TXfbinChunkIndexS32& value)
{
    return ReadTXfbinChunkIndexS32(value.Index, value.PageStart);
}

