#include "/../include.h";

// IDA context: NSUNS3HD_NX, nuccChunkAnmStrm_Parse @ 0x710002A784.
// The 20-byte header and mapping tables mirror nuccChunkAnm. References inside
// clumps use GetExtRefIndex; the two "other" tables use page-local GetIndex.
// Names describe reconstructed wire roles, not original C++ member names.
typedef struct
{
    u32 Offset;
    u32 Frame;
} TStrmFrameInfo <read=ReadTStrmFrameInfo>;

typedef struct {
    local u16 chunkVersion = parentof(this).Version;
    u32 AnmLength; // Animation time units; nuccAnmTimePerSec = 3000 in this build.
    u32 FrameSize; // Time step between stream frames, not a byte size.
    
    u16 EntryCount; // Number of 8-byte seek-table entries at the end of this chunk.
    u16 Looped;
    
    u16 ClumpCount;
    u16 OtherEntryCount;
    

    u16 OtherIndexCount;
    u16 CoordCount;

    local int i;

    local int FrameCount = EntryCount; // Parser reads 8 * EntryCount bytes.
    struct{
    for (i = 0; i < ClumpCount; i++)
        {
            struct
            {   
                u32 ClumpIndex;
                u16 BoneMaterialCount;
                u16 ModelCount;
                u32 BoneMaterialIndices[BoneMaterialCount];
                u32 ModelIndices[ModelCount];
                if (chunkVersion >= 0x75)
                {
                    u32 ModelReserved[ModelCount]; // Read and discarded from v0x75 onward.
                }
    
            } Clump;
        }
    }Clumps;

    u32 OtherEntryChunkIndices[OtherEntryCount];
    u32 OtherChunkIndices[OtherIndexCount];

// This is bones parents: first u32 is parent, second u32 is child (or current bone)
    struct TCoordParent CoordParents[CoordCount];


    struct{

        for (i = 0; i < FrameCount; i++)
            {
                struct TStrmFrameInfo FrameInfo;
            }
    }Frames;
    
    

} TNuccAnmStrm <optimize=false>;

string ReadTStrmFrameInfo(TStrmFrameInfo& value)
{
    local string str;
    SPrintf(str, "Frame %d @ 0x%X", value.Frame, value.Offset);
    return str;
}
