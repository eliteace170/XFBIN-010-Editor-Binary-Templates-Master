#include "/../include.h"

typedef struct
{
    // NX 0x7101131234 / PC 0x140A74E60 read a 12-byte wrapper, then Size bytes of NUT.
    u16 Field00 <comment="Only the first byte is copied to the runtime texture flags; full bit meanings are unverified.">;
    u16 Width;
    u16 Height;
    u16 Field06 <comment="Not used by the inspected texture Parse methods; retained verbatim.">;

    u32 Size <comment="Embedded NUT byte size, excluding this 12-byte texture wrapper.">;

    #ifdef NUT
        FPushBase();
        {
            TNut Nut;
        }
        FPopBase();
    #else
        u8 Data[Size];
    #endif
} TNuccTexture;
