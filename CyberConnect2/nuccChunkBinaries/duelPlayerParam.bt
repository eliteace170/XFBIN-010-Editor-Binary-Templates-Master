}DPP_Entry <optimize=false, read= Str("%s" + "prm_bas",MotionCode)>;
    // Extra bytes belong to this binary record, outside the stock 0x2D8 core.
    // The supplied Evo records contain 0x20 zero bytes here. Never interpret
    // this as the next chunk or apply a Storm 3 layout to it.
    if (FileSize > 0x2D8)
        ubyte ExtraTail[FileSize - 0x2D8] <comment="Preserved extension bytes. Mod-specific meaning unresolved; excluded from S4/Connections runtime core copies.">;
}
duelPlayerParam <optimize = false>;
