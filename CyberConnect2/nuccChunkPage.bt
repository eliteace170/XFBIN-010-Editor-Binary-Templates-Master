#include "/../include.h"

typedef struct
{
    // NX nuccChunkPage::Parse 0x71010E549C -> ChangePage, not byte counts.
    u32 PageSize <comment="Number of chunk-map index entries consumed by this page; advances the next page's index base.">;
    u32 ReferenceSize <comment="Number of external-reference table entries consumed by this page.">;
} TNuccPage;
