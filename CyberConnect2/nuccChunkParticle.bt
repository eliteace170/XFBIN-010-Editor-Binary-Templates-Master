//   Version: 2.0
//   Purpose: Parse CC2 nuccChunkParticle data
//   History:
//   1.0 - Initial release
//   1.1 - Names/layout updated from Blender-XFBIN-Importer br_particle.py
//   2.0 - Layout updated from Storm 4 and Connections 1.70 executables
//------------------------------------------------

#include "/../include.h";

#ifndef XFBIN_CHUNK_INDEX_READERS
#define XFBIN_CHUNK_INDEX_READERS
string ReadTXfbinChunkIndexU32(u32& value, u32 pageStart)
{
    local string str;
    if (exists(Xfbin) && pageStart + value < Xfbin.ChunkTable.ChunkMapIndicesCount)
    {
        return ReadTChunkMap(Xfbin.ChunkTable.ChunkMaps[GetChunkMapIndex(value, pageStart)]);
    }
    SPrintf(str, "ChunkIndex[%u]", value);
    return str;
}

string ReadTXfbinChunkIndexS32(s32& value, u32 pageStart)
{
    local string str;
    if (value < 0)
    {
        SPrintf(str, "ChunkIndex[%d]", value);
        return str;
    }
    if (exists(Xfbin) && pageStart + value < Xfbin.ChunkTable.ChunkMapIndicesCount)
    {
        return ReadTChunkMap(Xfbin.ChunkTable.ChunkMaps[GetChunkMapIndex(value, pageStart)]);
    }
    SPrintf(str, "ChunkIndex[%d]", value);
    return str;
}
#endif

enum <u32> TParticleResourceType
{
    ParticleResourceClump = 1,
    ParticleResourceAnm = 2,
    ParticleResourceSprite = 3,
    ParticleResourceSprite2 = 4,
    ParticleResourceBillboard = 5
};

enum <u8> TParticleSpawnType
{
    ParticleSpawnPoint = 0,
    ParticleSpawnPlanarCircle = 1,
    ParticleSpawnSphere = 2,
    ParticleSpawnTubeRandomEnd = 3,
    ParticleSpawnTubeForward = 4,
    ParticleSpawnTubeReverse = 5
};

enum <u8> TParticleDirectionType
{
    ParticleDirectionOutward = 0,
    ParticleDirectionInward = 1,
    ParticleDirectionRandomXYZ = 2,
    ParticleDirectionLocalCone = 3
};

enum <u8> TParticleRotationType
{
    ParticleRotationZero = 0,
    ParticleRotationRandomXYZ = 1,
    ParticleRotationAxisAligned = 2,
    ParticleRotationAxisRandomY = 3
};

string ReadTParticleNormalizedU16(u16& value)
{
    local string str;
    SPrintf(str, "%.6f", (float)value / 0xFFFF);
    return str;
}

string ReadTParticleTimelineValue(u32& value)
{
    local string str;
    local u32 timeMS = value & 0x7FFFFFFF;
    if ((value & 0x80000000) != 0)
    {
        SPrintf(str, "ENABLED - %u ms (30 FPS frame %u)", timeMS, timeMS / 33);
    }
    else
    {
        SPrintf(str, "DISABLED - %u ms (30 FPS frame %u)", timeMS, timeMS / 33);
    }
    return str;
}

typedef struct
{
    f32 R;
    f32 G;
    f32 B;
    f32 A;

    local int bgcolor_particle =
        (R * 0xFF) + (G * 0xFF) * 0x100 + (B * 0xFF) * 0x10000;
} TParticleColor <bgcolor=bgcolor_particle>;

typedef struct
{
    u32 Position;       // Stored but ignored by the game parser.
    u16 EntryCount;
    u16 EntrySize;      // Informational; the game uses version-specific sizes.
} TParticleHeader;

typedef struct(u32 currentPageStart)
{
    local u32 pageStart = currentPageStart;

    u32 AnimationChunkIndex
        <read=ReadTXfbinChunkIndexU32(this, parentof(this).pageStart)>;
    u32 EntryIndex;
    u8 Reserved08[8];

    // nuccParticleGenParam begins at record offset 0x10.
    u8 AllocationMode;
    enum TParticleSpawnType SpawnType;
    enum TParticleDirectionType DirectionType;
    u8 ParticleInstanceMode;
    enum TParticleRotationType RotationType;
    u8 ControlRate;
    u8 GeneratorFlags;       // bit 0: independent random XYZ scale
                             // bit 4: position-node path adjustment
    u8 ParticleBehaviorType;
    u8 ParticleInstanceFlags[4];
    s16 GeneratorEndTime;    // -1 = endless
    u16 ExtendedDataFlags;   // low byte enables the v0x7B extension

    f32 ParticleCountOrRate;
    f32 SpawnRadius;
    f32 SpawnRadiusRandomness;
    u16 Lifetime;
    u16 Reserved2E;
    f32 LifetimeRandomness;
    f32 InitialSpeed;
    f32 InitialSpeedRandomness;
    f32 EmissionAngle1;
    f32 EmissionAngle2;
    f32 EmissionAngle1Randomness;
    f32 EmissionAngle2Randomness;
    f32 FadeParameter1;
    f32 FadeParameter2;
    f32 InitialRotation;
    f32 InitialRotationRandomness;

    struct TVector3 StartScale;
    struct TVector3 RandomScale;
    struct TVector3 MiddleScale;
    struct TVector3 EndScale;
    f32 ScaleInterpolationPoint;

    struct TParticleColor StartColor;
    struct TParticleColor MiddleColor;
    struct TParticleColor EndColor;
    f32 ColorInterpolationPoint;
    u32 FieldC4;
    u32 FieldC8;
    u32 FieldCC;
} TParticleManager <optimize=false>;

typedef struct(u32 currentPageStart)
{
    local u32 pageStart = currentPageStart;

    u32 EffectChunkIndex
        <read=ReadTXfbinChunkIndexU32(this, parentof(this).pageStart)>;
    u32 ParticleEntryIndex;
    u8 Reserved08[8];
    u16 Parameter0 <read=ReadTParticleNormalizedU16>;
    u16 Parameter1 <read=ReadTParticleNormalizedU16>;
    u16 Parameter2 <read=ReadTParticleNormalizedU16>;
    u16 Parameter3 <read=ReadTParticleNormalizedU16>;
    u16 Parameter4 <read=ReadTParticleNormalizedU16>;
    u16 Parameter5 <read=ReadTParticleNormalizedU16>;
    enum TParticleResourceType ResourceType;
} TParticleResource <optimize=false>;

typedef struct(u32 currentPageStart, u16 currentChunkVersion)
{
    local u32 pageStart = currentPageStart;
    local u16 chunkVersion = currentChunkVersion;

    s32 CoordChunkIndex
        <read=ReadTXfbinChunkIndexS32(this, parentof(this).pageStart)>;
    u32 ParticleEntryIndex;
    s32 Field08;
    s32 Field0C;
    s32 Field10;
    f32 Field14;
    f32 Field18;
    s32 Field1C;
    s32 Field20;
    s32 Field24;
    s32 Field28;
    s32 Field2C;

    // Position records are 0x30 bytes through v0x77 and 0x38 afterward.
    if (chunkVersion > 0x77)
    {
        s32 ClumpChunkIndex
            <read=ReadTXfbinChunkIndexS32(this, parentof(this).pageStart)>;
        u32 Field34;
    }
} TParticlePosition <optimize=false>;

typedef struct(u32 currentPageStart, u16 currentChunkVersion)
{
    local u32 pageStart = currentPageStart;
    local u16 chunkVersion = currentChunkVersion;

    s32 CoordChunkIndex
        <read=ReadTXfbinChunkIndexS32(this, parentof(this).pageStart)>;
    u32 ParticleEntryIndex;
    s32 Field08;
    s32 Field0C;
    s32 Field10;
    f32 Field14;
    f32 Field18;
    s32 Field1C;
    s32 Field20;
    s32 Field24;
    s32 Field28;
    s32 Field2C;
    u16 Field30;
    u16 Field32;
    s32 Field34;
    f32 Field38;
    s32 Field3C;
    f32 Field40;
    f32 Field44;
    f16 Field48;
    f16 Field4A;
    f16 Field4C;
    f16 Field4E;
    f32 Field50;
    f32 ParticleSpeed;
    f32 Field58;
    f32 Field5C;

    // Force-field records are 0x60 bytes through v0x77 and 0x70 afterward.
    if (chunkVersion > 0x77)
    {
        s32 ClumpChunkIndex
            <read=ReadTXfbinChunkIndexS32(this, parentof(this).pageStart)>;
        s32 Field64;
        s32 Field68;
        s32 Field6C;
    }
} TParticleForceField <optimize=false>;

typedef struct
{
    u32 ValueCount;
    u32 Values[ValueCount] <read=ReadTParticleTimelineValue, optimize=false>;
    if (((4 + ValueCount * 4) % 8) != 0)
    {
        u8 Alignment[4];
    }
} TParticleTimeline <optimize=false>;

typedef struct
{
    local int i;
    local int HasExtendedParticleData = 0;
    local u32 pageStart = parentof(parentof(this)).pageStart;
    local u16 chunkVersion = parentof(this).Version;

    struct TParticleHeader ParticleHeaders[5];

    struct
    {
        for (i = 0; i < ParticleHeaders[0].EntryCount; i++)
        {
            struct TParticleManager ParticleManager(pageStart);
            if ((ParticleManager.ExtendedDataFlags & 0x00FF) != 0)
            {
                HasExtendedParticleData = 1;
            }
        }
    } ParticleManagers <optimize=false>;

    struct
    {
        for (i = 0; i < ParticleHeaders[1].EntryCount; i++)
        {
            struct TParticleResource ParticleResource(pageStart);
        }
    } ParticleResources <optimize=false>;

    struct
    {
        for (i = 0; i < ParticleHeaders[2].EntryCount; i++)
        {
            struct TParticlePosition ParticlePosition(pageStart, chunkVersion);
        }
    } ParticlePositions <optimize=false>;

    struct
    {
        for (i = 0; i < ParticleHeaders[3].EntryCount; i++)
        {
            struct TParticleForceField ParticleForceField(pageStart, chunkVersion);
        }
    } ParticleForceFields <optimize=false>;

    struct
    {
        for (i = 0; i < ParticleHeaders[4].EntryCount; i++)
        {
            struct TParticleTimeline ParticleTimeline;
        }
    } ParticleTimelines <optimize=false>;

    // Connections v0x7B reads this only when a manager enables the flag.
    if (chunkVersion >= 0x7B && HasExtendedParticleData != 0)
    {
        u64 ExtendedDataSize;
        u8 ExtendedData[ExtendedDataSize];
    }
} TNuccParticle <optimize=false>;
